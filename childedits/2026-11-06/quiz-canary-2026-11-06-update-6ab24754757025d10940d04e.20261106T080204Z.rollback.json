       "alpb---prompt": "<p>Build a style quiz that collects every answer in a database I own.</p><div data-rt-embed-type='true'><div data-rt-embed-type='true'><script> window.awbPrompt = {\"default\": \"Build a style quiz that collects every answer in a database I own.\", \"chips\": [{\"label\": \"Fashion Style Quiz\", \"add\": \"Add an eight-question quiz that sorts answers into five fashion styles.\"}, {\"label\": \"Product Matches\", \"add\": \"Add product matches for each result from the tagged catalog items.\"}, {\"label\": \"Client Intake\", \"add\": \"Add a client intake step that asks for sizes and a season budget.\"}, {\"label\": \"Home Decor Quiz\", \"add\": \"Add a home decor quiz that sorts answers into room styles.\"}]}; </script></div></div><div data-rt-embed-type='true'><div data-rt-embed-type='true'><script id='awb-quiz-data'> window.awbQuiz = {\"version\":1,\"type\":\"matching\",\"title\":\"Find Your Fashion Style\",\"intro\":\"Eight questions about the clothes you reach for. Your result names the fashion style your answers lean toward, with pieces to build it around.\",\"questions\":[{\"text\":\"It's Saturday morning. What do you put on first?\",\"options\":[{\"text\":\"A crisp button-down and chinos\",\"result\":\"classic\"},{\"text\":\"A gray tee and black straight-leg jeans\",\"result\":\"minimal\"},{\"text\":\"A flowy printed maxi skirt\",\"result\":\"bohemian\"},{\"text\":\"An oversized hoodie and cargo pants\",\"result\":\"streetwear\"},{\"text\":\"A floral midi dress\",\"result\":\"romantic\"}]},{\"text\":\"Which pair of shoes gets the most wear?\",\"options\":[{\"text\":\"Chunky high-top sneakers\",\"result\":\"streetwear\"},{\"text\":\"Brown leather loafers\",\"result\":\"classic\"},{\"text\":\"Suede ankle boots with fringe\",\"result\":\"bohemian\"},{\"text\":\"Ballet flats with a small bow\",\"result\":\"romantic\"},{\"text\":\"Clean black leather sneakers\",\"result\":\"minimal\"}]},{\"text\":\"Pick a color palette for a new season.\",\"options\":[{\"text\":\"Black, white, and stone\",\"result\":\"minimal\"},{\"text\":\"Blush, cream, and lavender\",\"result\":\"romantic\"},{\"text\":\"Rust, olive, and mustard\",\"result\":\"bohemian\"},{\"text\":\"Hunter green, burgundy, and ivory\",\"result\":\"classic\"},{\"text\":\"Neon accents on washed black\",\"result\":\"streetwear\"}]},{\"text\":\"Which fabric do you reach for first?\",\"options\":[{\"text\":\"Crisp cotton poplin\",\"result\":\"classic\"},{\"text\":\"Lace and soft chiffon\",\"result\":\"romantic\"},{\"text\":\"Heavy fleece and nylon\",\"result\":\"streetwear\"},{\"text\":\"Smooth merino in one solid shade\",\"result\":\"minimal\"},{\"text\":\"Crochet and gauzy linen\",\"result\":\"bohemian\"}]},{\"text\":\"What sits on your jewelry tray?\",\"options\":[{\"text\":\"Pearl studs and a simple watch\",\"result\":\"classic\"},{\"text\":\"One thin gold chain\",\"result\":\"minimal\"},{\"text\":\"Stacked rings and beaded bracelets\",\"result\":\"bohemian\"},{\"text\":\"Thick silver chains\",\"result\":\"streetwear\"},{\"text\":\"A heart locket and hair ribbons\",\"result\":\"romantic\"}]},{\"text\":\"Which outfit would you wear to a friend's birthday dinner?\",\"options\":[{\"text\":\"A tailored blazer over a striped shirt\",\"result\":\"classic\"},{\"text\":\"A black knit top and wide trousers\",\"result\":\"minimal\"},{\"text\":\"A tiered peasant dress with sandals\",\"result\":\"bohemian\"},{\"text\":\"A graphic jacket with limited-edition sneakers\",\"result\":\"streetwear\"},{\"text\":\"A puff-sleeve blouse with a pleated skirt\",\"result\":\"romantic\"}]},{\"text\":\"Where do you find the pieces you love most?\",\"options\":[{\"text\":\"The tailoring section of a department store\",\"result\":\"classic\"},{\"text\":\"A small shop that sells only basics\",\"result\":\"minimal\"},{\"text\":\"Vintage markets and secondhand stores\",\"result\":\"bohemian\"},{\"text\":\"Sneaker drops and skate shops\",\"result\":\"streetwear\"},{\"text\":\"Boutiques full of lace and floral prints\",\"result\":\"romantic\"}]},{\"text\":\"What do you want an outfit to say?\",\"options\":[{\"text\":\"Put together\",\"result\":\"classic\"},{\"text\":\"Calm and uncluttered\",\"result\":\"minimal\"},{\"text\":\"Free and easy\",\"result\":\"bohemian\"},{\"text\":\"Current and confident\",\"result\":\"streetwear\"},{\"text\":\"Soft and sweet\",\"result\":\"romantic\"}]}],\"results\":[{\"key\":\"classic\",\"title\":\"Classic\",\"description\":\"Your answers lean toward tailored shapes, crisp cotton, and deep traditional colors. Build around a well-cut blazer, straight trousers, and leather loafers. Add one patterned shirt or silk scarf each season.\"},{\"key\":\"minimal\",\"title\":\"Minimalist\",\"description\":\"Your answers lean toward solid neutrals, clean lines, and fewer pieces that all work together. Pick three base colors, buy each staple in the best fabric you can afford, and skip prints unless one earns its place.\"},{\"key\":\"bohemian\",\"title\":\"Bohemian\",\"description\":\"Your answers lean toward loose layers, earthy colors, and handmade or vintage finds. Mix a flowing skirt or dress with suede, crochet, and stacked jewelry, and look in secondhand stores first.\"},{\"key\":\"streetwear\",\"title\":\"Streetwear\",\"description\":\"Your answers lean toward relaxed fits, sneakers, and graphic pieces with a current edge. Start from an oversized hoodie, cargo pants, and one standout pair of sneakers, and let a single bright accent carry the outfit.\"},{\"key\":\"romantic\",\"title\":\"Romantic\",\"description\":\"Your answers lean toward soft fabrics, pastel colors, and details like lace, bows, and puff sleeves. Build on midi dresses and blouses in blush or cream, and finish with delicate jewelry.\"}]}; </script></div></div>",
