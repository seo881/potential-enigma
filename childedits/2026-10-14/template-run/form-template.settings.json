    "data": {
     "type": "all_raw_settings",
     "total_matches": 4,
     "matches": [
      {
       "key": "domId",
       "value": ""
      },
      {
       "key": "visibility",
       "value": true
      },
      {
       "key": "code",
       "value": "<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var d = window.awbMockup;\n    if (!d) return;\n\n    var textEl = document.querySelector('[data-mockup-text]');\n    var btn = document.querySelector('[data-mockup-btn]');\n    var chips = document.querySelectorAll('[data-filter]');\n\n    if (btn && d.signup) btn.href = d.signup;\n\n    var selected = [];\n\n    chips.forEach(function (chip) {\n      chip.addEventListener('click', function () {\n        var n = chip.dataset.filter;\n        if (!n) return;\n        var idx = selected.indexOf(n);\n        if (idx > -1) {\n          selected.splice(idx, 1);\n          chip.classList.remove('is-active');\n        } else {\n          selected.push(n);\n          chip.classList.add('is-active');\n        }\n        update();\n      });\n    });\n\n    function update() {\n      var text = d.default || '';\n      if (selected.length > 0) {\n        var key = 's' + selected.slice().sort().join('');\n        if (d[key]) text = d[key];\n      }\n      if (!textEl) return;\n      if (textEl.tagName === 'INPUT' || textEl.tagName === 'TEXTAREA') {\n        textEl.value = text;\n      } else {\n        textEl.textContent = text;\n      }\n    }\n\n    update();\n  });\n</script>\n<style>\n  .build_input {\n    -ms-overflow-style: none; /* IE */\n  }\n\n  .build_input::-webkit-scrollbar {\n    display: none; /* Chrome, Safari */\n  }\n</style>"
      },
      {
       "key": "attributes",
       "value": []
      }
     ]
    }
   }
  ]
 },
