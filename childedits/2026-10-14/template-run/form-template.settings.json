       "value": "<style>\n/* MONDAY A3 (2026-10-12): comparison table at phone width. The table already scrolls inside .cmp (overflow-x auto, min-width 720px);\n   this keeps the feature labels in view and tightens the cells so rows are not five lines tall. Scoped to the child-page table section. */\n@media (max-width: 479px) {\n  .section_table .cmp table { min-width: 600px; }\n  .section_table .cmp th, .section_table .cmp td { padding: 14px 16px; }\n  .section_table .cmp thead th { padding-top: 16px; padding-bottom: 16px; font-size: 17px; line-height: 24px; }\n  .section_table .cmp th[scope='row'], .section_table .cmp td.col-brand, .section_table .cmp td.col-other { font-size: 15px; line-height: 21px; }\n  .section_table .cmp th[scope='row'], .section_table .cmp thead th.col-feature { position: sticky; left: 0; z-index: 1; background: #fff; min-width: 120px; max-width: 132px; box-shadow: 1px 0 0 #ececec; }\n}\n</style>\n<script>\n/* MONDAY A3 (2026-10-12): the FAQ heading comes from the item (window.awbFAQ.heading), not the fixed component text. */\n(function () {\n  function setHeading() {\n    var f = window.awbFAQ; if (!f || !f.heading) return;\n    var h = document.querySelector('.section_build-faq .faq_component h2');\n    if (h && h.textContent !== f.heading) h.textContent = f.heading;\n  }\n  setHeading();\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setHeading);\n})();\n</script>\n<script>\n/* FAQ open-height refit (2026-10-12): the FAQ component sets the open answer's max-height to its scrollHeight once, on Webflow ready,\n   often before Inter has loaded; when the web font swaps in, the answer wraps to one more line and the last line is clipped.\n   Re-fit the open answer whenever its text box changes size (font swap, heading change, width change). */\n(function () {\n  var seen = typeof WeakSet === 'function' ? new WeakSet() : null, ro;\n  function refit() {\n    document.querySelectorAll('.faq_accordion.faq-open .faq_answer').forEach(function (a) {\n      var px = a.scrollHeight + 'px'; if (a.style.maxHeight !== px) a.style.maxHeight = px;\n    });\n  }\n  function attach() {\n    if (!ro && window.ResizeObserver) ro = new ResizeObserver(refit);\n    if (ro && seen) document.querySelectorAll('.faq_answer > p').forEach(function (p) { if (!seen.has(p)) { seen.add(p); ro.observe(p); } });\n    refit();\n  }\n  window.Webflow = window.Webflow || [];\n  window.Webflow.push(function () { setTimeout(attach, 0); });\n  if (document.fonts && document.fonts.ready) document.fonts.ready.then(attach);\n  if (document.fonts && document.fonts.addEventListener) document.fonts.addEventListener('loadingdone', refit);\n  window.addEventListener('load', attach);\n})();\n\n</script>\n"
