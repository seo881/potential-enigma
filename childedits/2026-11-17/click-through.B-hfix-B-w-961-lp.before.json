  "meta-title": "Click Through Landing Page Examples and Builder | Emergent",
  "meta-description": "See 4 click through landing page examples, then build one that sends warmed-up visitors to your checkout or signup. Free to start.",
  "name": "Build a Click Through Landing Page That Hands Off to Checkout",
  "acrm---product-name": "Click Through Landing Page Builder",
  "description": "Build a click through landing page with one button that opens your checkout or signup with the visitor's choice already made.",
  "acrm---breadcrumb": "Click Through Landing Page",
  "explore-cta": "Build My Click Through Page",
  "acrm---key-feature-sub-heading": "A click through landing page explains the offer, then one button opens the page where the visitor buys or signs up.",
  "acrm---why-emergent-title": "Why Build a Click Through Page With Emergent?",
