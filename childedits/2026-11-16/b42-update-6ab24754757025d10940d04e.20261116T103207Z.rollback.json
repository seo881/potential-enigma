     {
      "id": "6afabd0f4fd422c130d19f1d",
      "fieldData": {
       "awb---mockup-data": "<p id=\"\">window.awbMockup = { placementQuiz: \"Build a 24-question French placement quiz for my adult language school, sent to everyone who signs up for the fall term. Place each student by score: 0 to 9 is Level 1, 10 to 17 is Level 2, and 18 to 24 is Level 3. Save each result with the student's name and level, and show me how many students land in each level.\", spanishClass: \"Build a 12-question Spanish past-tense quiz for my Spanish 2 class of 31 students. They take it on their phones every Thursday, one question per screen. Save each answer with the student and the question number, and show me which question the most students missed, so I can open the next class with it.\", festivalBooth: \"Build a guess-the-language quiz for a booth at my folk festival, played on a tablet for one weekend. Each of the 10 questions shows one sentence, and visitors pick the language from 4 options. Save every answer and show me the share of visitors who named each language correctly, lowest first.\", hotelFrontDesk: \"Build a 15-question quiz on the Spanish phrases guests use at check-in for new front-desk hires at my hotel. Save every score by hire. Anyone who scores under 12 of 15 gets posted to our #frontdesk-training channel in Slack, so a supervisor can book a practice shift with them.\" };</p>",
       "alpb---prompt": "<p>Build a language quiz for my adult French school that scores each new student and saves every answer.</p><div data-rt-embed-type='true'><div data-rt-embed-type='true'><script> window.awbPrompt = {\"default\": \"Build a language quiz for my adult French school that scores each new student and saves every answer.\", \"chips\": [{\"label\": \"Placement Levels\", \"add\": \"Add score bands that place each student in Level 1, 2, or 3.\"}, {\"label\": \"Phone Answers\", \"add\": \"Add one question per screen so students can answer on a phone.\"}, {\"label\": \"Scores by Skill\", \"add\": \"Add a results table that shows scores by skill, such as verbs and vocabulary.\"}, {\"label\": \"Slack Alerts\", \"add\": \"Add a Slack message that lists anyone who scores below the pass mark.\"}]}; </script></div></div><div data-rt-embed-type='true'><div data-rt-embed-type='true'><script id='awb-quiz-data'> window.awbQuiz = {\"version\":1,\"type\":\"knowledge\",\"title\":\"Language Quiz: 8 Questions on Alphabets and Language Families\",\"intro\":\"Eight questions on alphabets, language families, and one invented language. Pick one answer for each; your score and a source for every answer show at the end.\",\"questions\":[{\"text\":\"Which of these is one of the six official languages of the United Nations?\",\"options\":[{\"text\":\"German\"},{\"text\":\"Arabic\",\"correct\":true},{\"text\":\"Japanese\"},{\"text\":\"Portuguese\"}],\"explanation\":\"The six are Arabic, Chinese, English, French, Russian, and Spanish.\",\"source\":{\"url\":\"https://www.un.org/en/our-work/official-languages\",\"quote\":\"These are Arabic, Chinese, English, French, Russian and Spanish.\"}},{\"text\":\"The alphabet called Hangul is the writing system for which language?\",\"options\":[{\"text\":\"Japanese\"},{\"text\":\"Thai\"},{\"text\":\"Korean\",\"correct\":true},{\"text\":\"Mongolian\"}],\"explanation\":\"Hangul is the Korean alphabet, the modern writing system for Korean.\",\"source\":{\"url\":\"https://en.wikipedia.org/wiki/Hangul\",\"quote\":\"The Korean alphabet is the modern writing system for the Korean language.\"}},{\"text\":\"Which language of Europe is a language isolate, related to no other known language?\",\"options\":[{\"text\":\"Basque\",\"correct\":true},{\"text\":\"Welsh\"},{\"text\":\"Maltese\"},{\"text\":\"Albanian\"}],\"explanation\":\"Basque is Europe's only known language isolate, with no relation to any other known language.\",\"source\":{\"url\":\"https://en.wikipedia.org/wiki/Basque_language\",\"quote\":\"Basque is Europe's only known language isolate (with no relation to any other known languages)\"}},{\"text\":\"Which of these languages belongs to the Uralic family?\",\"options\":[{\"text\":\"Romanian\"},{\"text\":\"Polish\"},{\"text\":\"Hungarian\",\"correct\":true},{\"text\":\"Greek\"}],\"explanation\":\"Hungarian is a member of the Uralic language family.\",\"source\":{\"url\":\"https://en.wikipedia.org/wiki/Hungarian_language\",\"quote\":\"Hungarian is a member of the Uralic language family.\"}},{\"text\":\"Spanish, French, and Italian descend directly from which language?\",\"options\":[{\"text\":\"Ancient Greek\"},{\"text\":\"Vulgar Latin\",\"correct\":true},{\"text\":\"Old Norse\"},{\"text\":\"Sanskrit\"}],\"explanation\":\"The Romance languages, also called the Latin languages, descend directly from Vulgar Latin.\",\"source\":{\"url\":\"https://en.wikipedia.org/wiki/Romance_languages\",\"quote\":\"less commonly known as the Latin languages, are the languages that directly descended from Vulgar Latin\"}},{\"text\":\"Which language did L. L. Zamenhof create in 1887 for international use?\",\"options\":[{\"text\":\"Novial\"},{\"text\":\"Ido\"},{\"text\":\"Interlingua\"},{\"text\":\"Esperanto\",\"correct\":true}],\"explanation\":\"Zamenhof meant Esperanto as a universal second language for international communication.\",\"source\":{\"url\":\"https://en.wikipedia.org/wiki/Esperanto\",\"quote\":\"it is intended to be a universal second language for international communication\"}},{\"text\":\"Modern Icelandic developed from which earlier language?\",\"options\":[{\"text\":\"Old English\"},{\"text\":\"Latin\"},{\"text\":\"Old Norse\",\"correct\":true},{\"text\":\"Old Irish\"}],\"explanation\":\"Old Norse later became Old Icelandic, and then the Modern Icelandic spoken today.\",\"source\":{\"url\":\"https://en.wikipedia.org/wiki/Icelandic_language\",\"quote\":\"Icelandic is derived from an earlier language Old Norse, which later became Old Icelandic and currently Modern Icelandic.\"}},{\"text\":\"Swahili, spoken across East Africa, belongs to which group of languages?\",\"options\":[{\"text\":\"Bantu\",\"correct\":true},{\"text\":\"Semitic\"},{\"text\":\"Berber\"},{\"text\":\"Nilotic\"}],\"explanation\":\"Swahili is a Bantu language, part of the Sabaki branch.\",\"source\":{\"url\":\"https://en.wikipedia.org/wiki/Swahili\",\"quote\":\"Swahili is a Bantu language of the Sabaki branch.\"}}],\"results\":[{\"key\":\"starter\",\"title\":\"Language Explorer\",\"description\":\"You got 0 to 3 right. Alphabets and language families are a deep subject, and every answer above names its source, so the reading list is ready.\",\"min\":0,\"max\":3},{\"key\":\"middle\",\"title\":\"Well Traveled\",\"description\":\"You got 4 to 6 right. You know your way around the major language families. The ones you missed are the odd cases, like a language with no relatives.\",\"min\":4,\"max\":6},{\"key\":\"top\",\"title\":\"Language Expert\",\"description\":\"You got 7 or 8 right. You can place a language by its family, its alphabet, and the language it grew out of.\",\"min\":7,\"max\":8}]}; </script></div></div>",
       "acrm---key-feature-3-image": {
