       "alpb---prompt": "<p>Build HOA survey questions that ask my community's 214 homeowners to rank five amenity upgrades before the board sets next year's budget.</p><div data-rt-embed-type='true'><div data-rt-embed-type='true'><script> window.awbPrompt = {\"default\": \"Build HOA survey questions that ask my community's 214 homeowners to rank five amenity upgrades before the board sets next year's budget.\", \"chips\": [{\"label\": \"Amenity Ranking\", \"add\": \"Add a ranking of five amenity upgrades emailed before the budget meeting.\"}, {\"label\": \"Lawn Care Review\", \"add\": \"Add a landscaping review that emails the manager on ratings of 2 or lower.\"}, {\"label\": \"New Owner Check\", \"add\": \"Add a five-question check emailed to new owners 30 days after closing.\"}, {\"label\": \"EV Charger Poll\", \"add\": \"Add a phone survey for condo units on one shared garage charger.\"}]}; </script></div></div>"
      }
     },
     {
