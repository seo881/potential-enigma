 "plan": {
  "angle": "No live top 10 for this Wave 3 keyword; the query is a local league registrar looking for a sign-up form, and the template galleries that rank for registration forms stop at name, birth date and parent contact. This page wins on the two jobs that are specific to a Little League season: working out league age (August 31 for baseball, December 31 for softball, per Little League's own pages) and collecting residency documents from each of the three groups, plus family checkout and volunteer shifts. Builder intent only; no affiliation with Little League International is implied.",
  "tab_stories": [
   "Juniper Flats Little League puts league ages 9 and 10 in Minors; Lachlan Ruvalcaba turns 10 on July 19, is 10 by August 31, and the form places him in Minors and emails his mother a confirmation.",
   "Ingrid Deverell turns 11 on November 3; her baseball league age would be 10, but softball uses December 31, so she registers as an 11-year-old and lands in Softball Majors, where Juniper Flats places ages 11 and 12.",
   "Della Brightmore uploads one document from each of the three residency groups; the app reads 418 Quarry Bend Road from two of them, and the blurry third scan goes to registrar Anselm Nadeau to check by hand.",
   "Juniper Flats needs 120 concession stand shifts covered and each family claims 2 while registering; the Ostergaard family takes the final pair, and volunteer coordinator Pilar Kitteridge gets an email that all 120 are covered."
  ],
  "openers": [
   "Juniper Flats Little League puts league ages 9 and 10",
   "Ingrid Deverell turns 11 on November 3",
   "Della Brightmore uploads one document",
   "Juniper Flats needs 120 concession stand shifts",
   "Write down the divisions your board runs",
   "Submit 3 test families yourself",
   "Post the link where families already look"
  ],
  "heading_shapes": [
   "A July 19 birthday puts Lachlan in Minors",
   "Ingrid signs up for softball at age 11",
   "One blurry scan goes to the registrar",
   "Pilar hears that every concession shift is covered"
  ],
  "claims_to_source": [
   "Little League Baseball divisions use an age determination date of August 31",
   "Little League Softball divisions use an age determination date of December 31",
   "Little League residency is supported by documents from each of the three groups",
   "Three documents from the same group count as only one document",
   "School attendance is supported by a document showing enrollment for the current academic year"
  ]
 }
